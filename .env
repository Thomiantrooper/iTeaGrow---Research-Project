# Tea Leaf Disease Detection System - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teadisease

# For production, use strong passwords:
# DATABASE_URL=postgresql://teauser:STRONG_PASSWORD_HERE@db.example.com:5432/teadisease

# ===================
# OBJECT STORAGE (MinIO/S3)
# ===================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=tea-disease-images
MINIO_BUCKET_MODELS=tea-disease-models

# For production with AWS S3:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1
# S3_BUCKET=your-bucket-name

# ===================
# REDIS
# ===================
REDIS_URL=redis://localhost:6379

# For production:
# REDIS_URL=redis://:password@redis.example.com:6379

# ===================
# MQTT (IoT Sensors)
# ===================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tea/sensors

# For production with TLS:
# MQTT_BROKER=mqtt.example.com
# MQTT_PORT=8883
# MQTT_USERNAME=sensor_user
# MQTT_PASSWORD=STRONG_PASSWORD_HERE
# MQTT_USE_TLS=true

# ===================
# API SETTINGS
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# For production:
# API_DEBUG=false
# API_WORKERS=4

# ===================
# JWT AUTHENTICATION
# ===================
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===================
# MODEL SETTINGS
# ===================
MODEL_PATH=./models/best.onnx
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45

# ===================
# LOGGING
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=json

# For development:
# LOG_LEVEL=DEBUG
# LOG_FORMAT=text

# ===================
# SENTRY (Error Tracking)
# ===================
# SENTRY_DSN=https://xxx@sentry.io/yyy

# ===================
# MOBILE APP
# ===================
# API URL for mobile app (change based on environment)
# Local development (Android emulator): http://10.0.2.2:8000
# Local development (iOS simulator): http://localhost:8000
# Local device on network: http://YOUR_IP:8000
# Production: https://api.yourdomain.com
MOBILE_API_URL=http://localhost:8000

# ===================
# FEATURE FLAGS
# ===================
ENABLE_GRADCAM=true
ENABLE_SENSOR_INTEGRATION=true
ENABLE_CLOUD_SYNC=true
