APP_NAME=Tea Leaf Disease Detection API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=4

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tealeaf_db
DB_USER=tealeaf
DB_PASSWORD=change_this_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=tea-leaf-images
MINIO_BUCKET_MODELS=tea-leaf-models
MINIO_BUCKET_EXPORTS=tea-leaf-exports

MODEL_PATH=models/yolov8n_tealeaf.pt
ONNX_MODEL_PATH=models/yolov8n_tealeaf.onnx
USE_ONNX=true
USE_INT8=false
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
MAX_DETECTIONS=100

SENSOR_TIMEOUT=30
DATA_RETENTION_DAYS=90
AGGREGATION_INTERVAL=300

# Temperature thresholds (Celsius)
TEMP_MIN=10.0
TEMP_MAX=35.0

# Humidity thresholds (%)
HUMIDITY_MIN=20.0
HUMIDITY_MAX=100.0

# Soil moisture thresholds (%)
SOIL_MOISTURE_MIN=0.0
SOIL_MOISTURE_MAX=100.0

# Light intensity thresholds (lux)
LIGHT_MIN=0.0
LIGHT_MAX=100000.0

LOCAL_STORAGE_PATH=./storage/local
SYNC_INTERVAL=300
MAX_OFFLINE_DAYS=7
COMPRESSION_ENABLED=true
MAX_QUEUE_SIZE=10000

# Encryption key for local storage (32+ character string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# Secret key for JWT tokens (32+ character string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-use-strong-key

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

CUDA_VISIBLE_DEVICES=0
