# =============================================================================
# GIT ATTRIBUTES - Line Endings & File Handling
# =============================================================================
# Ensures consistent line endings and proper diff/merge behavior across
# all platforms (Windows, macOS, Linux).
# =============================================================================

# =============================================================================
# DEFAULT BEHAVIOR
# =============================================================================
# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# =============================================================================
# SOURCE CODE - Force LF
# =============================================================================
# Python
*.py text eol=lf diff=python
*.pyx text eol=lf
*.pyd binary
*.pyo binary
*.pyc binary

# Dart/Flutter
*.dart text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Web
*.html text eol=lf diff=html
*.htm text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# Arduino/C++
*.ino text eol=lf
*.cpp text eol=lf diff=cpp
*.c text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp

# =============================================================================
# CONFIGURATION FILES - Force LF
# =============================================================================
# YAML/JSON/TOML
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# INI/Config
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Environment
.env* text eol=lf
*.env text eol=lf

# Docker
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# =============================================================================
# SHELL SCRIPTS
# =============================================================================
# Unix scripts must have LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Windows scripts must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# =============================================================================
# DOCUMENTATION
# =============================================================================
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.rst text eol=lf
*.txt text eol=lf
*.adoc text eol=lf

LICENSE text eol=lf
CHANGELOG text eol=lf
README* text eol=lf
CONTRIBUTING* text eol=lf

# =============================================================================
# DATA FILES
# =============================================================================
# CSV/TSV - keep as-is for data integrity
*.csv text eol=lf
*.tsv text eol=lf

# SQL
*.sql text eol=lf

# XML
*.xml text eol=lf

# =============================================================================
# BINARY FILES - Never normalize
# =============================================================================
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.bmp binary
*.tiff binary
*.tif binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.rar binary
*.7z binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# =============================================================================
# ML MODEL FILES - Binary, use Git LFS
# =============================================================================
# PyTorch models
*.pt binary filter=lfs diff=lfs merge=lfs -text
*.pth binary filter=lfs diff=lfs merge=lfs -text

# ONNX models
*.onnx binary filter=lfs diff=lfs merge=lfs -text

# TensorFlow/Keras
*.h5 binary filter=lfs diff=lfs merge=lfs -text
*.pb binary filter=lfs diff=lfs merge=lfs -text
*.tflite binary filter=lfs diff=lfs merge=lfs -text

# Other ML formats
*.pkl binary filter=lfs diff=lfs merge=lfs -text
*.joblib binary filter=lfs diff=lfs merge=lfs -text
*.safetensors binary filter=lfs diff=lfs merge=lfs -text
*.bin binary

# =============================================================================
# FLUTTER/DART SPECIFIC
# =============================================================================
# Lock files should be committed with consistent endings
pubspec.lock text eol=lf
*.lock text eol=lf

# Generated Dart files
*.g.dart text eol=lf linguist-generated=true
*.freezed.dart text eol=lf linguist-generated=true

# =============================================================================
# BUILD ARTIFACTS - Don't normalize
# =============================================================================
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary

# Python wheels/packages
*.whl binary
*.egg binary

# Flutter/Android
*.apk binary
*.aab binary
*.dex binary

# iOS
*.ipa binary

# =============================================================================
# SECURITY FILES - Handle carefully
# =============================================================================
*.pem binary
*.key binary
*.crt binary
*.cer binary
*.p12 binary
*.pfx binary

# =============================================================================
# JUPYTER NOTEBOOKS
# =============================================================================
*.ipynb text eol=lf diff=jupyter linguist-language=Python

# =============================================================================
# LINGUIST OVERRIDES - For GitHub language stats
# =============================================================================
# Ignore generated files in language statistics
*.min.js linguist-generated=true
*.min.css linguist-generated=true
**/generated/** linguist-generated=true
**/build/** linguist-generated=true

# Mark vendored files
**/vendor/** linguist-vendored=true
**/node_modules/** linguist-vendored=true

# Documentation
docs/** linguist-documentation=true

# =============================================================================
# DIFF DRIVERS
# =============================================================================
# These require git config setup:
# git config diff.jupyter.textconv "jupyter nbconvert --to script --stdout"
# git config diff.lockfile.textconv "cat"

# Lock files (show full diff)
package-lock.json text eol=lf -diff
yarn.lock text eol=lf -diff
